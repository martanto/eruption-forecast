{
  "name": "eruption-forecast-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../../openapi.json -o src/api/generated/schema.d.ts",
    "check:api": "openapi-typescript ../../openapi.json -o src/api/generated/schema.d.ts --check",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
